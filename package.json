{
  "name": "ao-pi",
  "version": "0.1.0",
  "description": "Pi / PiG extension for Agent Office: /office connects through OAuth, adds the Office MCP tools and reports working/idle status",
  "type": "module",
  "main": "index.ts",
  "exports": "./index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-office"
  ],
  "files": [
    "index.ts",
    "lib/office.ts",
    "lib/token.mts",
    "poll.ts"
  ],
  "repository": "github:az-iar/ao-pi",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.mts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^24.6.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
